{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(python3:*)",
      "Bash(echo:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(pytest:*)",
      "Bash(git status)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(git push:*)",
      "Bash(curl:*)"
    ]
  },
  "autoCompactEnabled": true,
  "statusLine": {
    "type": "command",
    "command": ".claude/statusline.sh",
    "padding": 0
  },
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8317",
    "ANTHROPIC_AUTH_TOKEN": "local-test-key",
    "ANTHROPIC_MODEL": "glm-5.2-fp8-393k",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-5.2-fp8-393k",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-5.2-fp8-393k",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-5.2-fp8-393k",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32768",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "393216"
  }
}