# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo

# Node
node_modules/
dist/
.npm/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Go
vendor/

# Build artifacts
build/
out/
target/

# Secrets (CRITICAL)
.mcp.json
k8s-mcp.toml
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Logs
*.log
!.claude/audit.log

# Claude local-only state
.claude/settings.local.json
.claude/.cache/

# Session reports — machine-generated by the SessionEnd/PreCompact hooks, and by
# every `claude plugin install` (each run leaves a fresh session-end.md). Keep
# the directory, ignore its contents.
.claude/session-reports/*
!.claude/session-reports/.gitkeep

# Transcript rescues, editor/tool backups, and scratch caches under .claude/.
# A rescued transcript can be tens of MB — never a git object. (v0.3.1: a
# session-rescue .jsonl.bak reached 70 MB in a real repo and broke its push.)
.claude/session-rescue/
.claude/**/*.bak
.claude/*.bak
.claude/.cc-writes/
.claude/**/__pycache__/

# Template upgrade backups
.claude.pre-upgrade-*/

# local runtime state — never commit
config/cli-proxy-api.local.yaml
*.local.yaml
.cli-proxy-api/

# local agent/dev config — personal to the maintainer, not part of the deliverable
.claude/
AGENTS.md
CLAUDE.md
.mcp.json.example

# proxy runtime artifact (2.7MB management UI, rewritten on every run)
config/static/
